{
  "manifest_version": 3,
  "name": "Stream Chat Rewards Cleaner (Kick & Twitch)",
  "version": "1.0.0",
  "description": "Oculte ou filtre resgates de pontos do canal, bônus de minigames (PokeIdle) e alertas no chat da Kick e Twitch.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.kick.com/*",
    "*://*.twitch.tv/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Stream Chat Cleaner Settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stream-chat-cleaner@local.addon",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.kick.com/*",
        "*://*.twitch.tv/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
